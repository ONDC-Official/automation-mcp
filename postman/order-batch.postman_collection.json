            "url": {
              "raw": "{{base_url}}/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "Every order in the batch: its real order id, order status, payment status and amount, once the seller has assigned them. Cheapest of the payload-reading requests \u2014 reads only the last couple of payloads per order. Paginated by payload_limit."
          },
          "response": []
        },
        {
          "name": "5. Batch payloads - one action for every order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
