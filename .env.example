# Copy to .env and adjust. The app refuses to boot on invalid config.

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP transport (entrypoints/http.ts). Ignored by the stdio entrypoint. ---
PORT=3000
# Bind loopback by default. Only widen this behind a trusted proxy.
HOST=127.0.0.1

# Public URL of this MCP server. Used as the RFC 9728 `resource` identifier
# and in the WWW-Authenticate challenge, so it must match what clients dial.
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp

# Comma-separated hostnames allowed in the Host header (DNS-rebinding
# protection). Leave unset to default to the localhost set.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins allowed for browser clients (CORS + Origin check).
# MCP_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
# none  = no verification (local dev only; refused when NODE_ENV=production)
# jwt   = verify RS256/ES256 bearer tokens against AUTH_JWKS_URL
AUTH_MODE=none
# AUTH_ISSUER=https://auth.example.com
# AUTH_AUDIENCE=https://api.example.com/mcp
# AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Space- or comma-separated scopes every request must carry.
# AUTH_REQUIRED_SCOPES=mcp

# --- Limits ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=30000

# --- ONDC config-service ---
# The single source of builds (domain/version/usecase), flow definitions and
# mock-runner configs. Nothing is bundled locally: if this is wrong or
# unreachable, session creation fails and /ready reports the dependency down.
CONFIG_SERVICE_URL=https://workbench.ondc.tech/config-service
CONFIG_SERVICE_TIMEOUT_MS=15000

# How long fetched builds/flows/mock configs stay cached (15 min).
CATALOG_CACHE_TTL_MS=900000

# Session lifetime (48h — matches the workbench's own session TTL).
SESSION_TTL_MS=172800000

# --- Shared state store ---
# Where sessions, transactions, payloads and business data live.
#
# Leave it unset and everything stays in-process: zero infrastructure, but a
# restart wipes it — including the `tsx watch` reload that fires every time you
# save a file mid-flow. Set it and the same state survives both.
#
#   docker compose -f docker-compose.dev.yml up -d
#   REDIS_URL=redis://127.0.0.1:6379
#
# The flow catalog is deliberately never stored here — it is large, derived, and
# re-fetched on demand. See the comments in src/container.ts.
# REDIS_URL=redis://127.0.0.1:6379

# Prepended to every key with `::`, so several projects can share one local
# Redis without collision. Set it empty to write the workbench's literal key
# layout into a Redis it also uses.
REDIS_KEY_PREFIX=ondc-mcp

# Hard ceiling on a single Redis command. Kept below /ready's own 2s probe
# timeout, and it bounds the ACK window — the receiver reads state before it
# answers, so a dead store must not hold the participant's connection open.
REDIS_COMMAND_TIMEOUT_MS=1500

# --- This mock's own wire presence ---
# The participant under test calls us back on these. Under the HTTP transport
# the receiver is mounted on PORT; on stdio it binds RECEIVER_PORT of its own.
RECEIVER_PORT=3001
# What we advertise as bap_uri / bpp_uri. Set this to a tunnel address
# (ngrok, cloudflared) whenever the participant is not on this machine —
# otherwise its callbacks are sent somewhere it cannot reach.
# RECEIVER_PUBLIC_URL=https://your-tunnel.example.com
# Path the receiver and form routes mount under. Defaults to the pathname of
# RECEIVER_PUBLIC_URL, so a deployment behind https://host/api-service works
# unchanged. Set it empty when a proxy strips the prefix before we see it.
# RECEIVER_ROUTE_PREFIX=
# Registry-style id we present as bap_id / bpp_id.
MOCK_SUBSCRIBER_ID=mock.ondc-mcp.local

# --- Flow loop ---
# Budget for one outbound protocol call to the participant.
SEND_TIMEOUT_MS=15000
# Ceiling on one blocking flow_await (5 min) — how long the mock will sit
# waiting for the participant to call back before answering `timed_out` and
# letting the model wait again. Not bounded by REQUEST_TIMEOUT_MS (that bounds
# receiving a request, not running its handler); the ceiling that matters is
# your MCP client's own tool-call timeout, which flow_await holds off with
# progress notifications while it waits.
AWAIT_MAX_WAIT_MS=300000
# Per-step WORKING/AVAILABLE marker lifetime (5h, as the workbench).
FLOW_STATUS_TTL_MS=18000000
# How long an idle mock-runner instance (and its worker threads) is kept.
RUNNER_CACHE_TTL_MS=300000
# Base URLs a sandboxed generate() may fetch. Empty = fetch is never injected.
# RUNNER_FETCH_ALLOWLIST=https://finvu.example.com
# Budget for fetching a counterparty-hosted form.
FORM_FETCH_TIMEOUT_MS=10000
# Transaction records and stored payloads (48h).
TRANSACTION_TTL_MS=172800000
# How long an armed expectation stands (5 min, as the workbench).
EXPECTATION_TTL_MS=300000
