# Copy to .env and adjust. The app refuses to boot on invalid config.

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP transport (entrypoints/http.ts). Ignored by the stdio entrypoint. ---
PORT=3000
# Bind loopback by default. Only widen this behind a trusted proxy.
HOST=127.0.0.1

# Public URL of this MCP server. Used as the RFC 9728 `resource` identifier
# and in the WWW-Authenticate challenge, so it must match what clients dial.
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp

# Comma-separated hostnames allowed in the Host header (DNS-rebinding
# protection). Leave unset to default to the localhost set.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins allowed for browser clients (CORS + Origin check).
# MCP_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
# none   = no verification (local dev only; refused when NODE_ENV=production)
# apikey = bearer token must match one of the comma-separated AUTH_API_KEYS
# jwt    = verify RS256/ES256 bearer tokens against AUTH_JWKS_URL
AUTH_MODE=none
# AUTH_API_KEYS=changeme,anotherkey
# AUTH_ISSUER=https://auth.example.com
# AUTH_AUDIENCE=https://api.example.com/mcp
# AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Space- or comma-separated scopes every request must carry.
# AUTH_REQUIRED_SCOPES=mcp

# --- Limits ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=30000

# --- ONDC config-service ---
# The single source of builds (domain/version/usecase), flow definitions and
# mock-runner configs. Nothing is bundled locally: if this is wrong or
# unreachable, session creation fails and /ready reports the dependency down.
CONFIG_SERVICE_URL=https://workbench.ondc.tech/config-service
CONFIG_SERVICE_TIMEOUT_MS=15000

# How long fetched builds/flows/mock configs stay cached (15 min).
CATALOG_CACHE_TTL_MS=900000

# Session lifetime (48h — matches the workbench's own session TTL).
SESSION_TTL_MS=172800000

# --- Protocol validation (L0 + L1) ---
# The api-service instance used as a validation oracle.
#
# POST {base}/{domain}/{version}/test/{action} is ONIX's `standaloneValidator`
# module: the same JSON Schemas and the same compiled x-validations the live
# network enforces. It has no side effects — nothing is proxied onward, nothing
# is stored, no session or transaction is created — which is what makes it safe
# to call on every payload in and out.
#
# Domain and version are baked into each api-service instance at build time, so
# an instance that does not serve your build answers 404 and validation reports
# `unavailable` rather than failing the payload.
VALIDATION_SERVICE_URL=https://workbench.ondc.tech/api-service

# Ceiling on one validation call. Deliberately far below SEND_TIMEOUT_MS: this
# runs inside the inbound ACK window, and a dependency that has stopped
# answering must not hold the participant's connection open. On timeout the
# verdict is `unavailable` and the call is let through.
VALIDATION_TIMEOUT_MS=2000

# How hard a verdict bites.
#   enforce  — an invalid payload is NACKed inbound and blocked outbound
#   advisory — findings are recorded and journaled, nothing is blocked
#   off      — no call is made at all
# None of these change the verdict, only what the gates do with it, so a
# transaction's recorded findings never depend on this setting.
VALIDATION_MODE=enforce

# How long a verdict stays cached (15 min). Keyed on the payload's own bytes,
# so it only ever helps a retry or a re-run — never a new payload.
VALIDATION_CACHE_TTL_MS=900000

# --- Prometheus ---
# Whether GET /metrics is registered at all. Off registers no route, so the
# endpoint 404s like any other path this app does not serve — "there is nothing
# here" rather than "there is something here you may not have".
METRICS_ENABLED=1

# Bearer token a scraper must present. **Required when NODE_ENV=production**
# and metrics are on — env.ts refuses to boot otherwise, for the same reason it
# refuses AUTH_MODE=none: this process is built to be internet-reachable (that
# is what RECEIVER_PUBLIC_URL is for), and an open /metrics publishes a map of
# what is being tested — every flow, every build, every failure rate.
# METRICS_TOKEN=change-me

# --- The live viewer ---
# A read-only JSON surface at /ui/api that a hosted page reads to show a session,
# its flows, its payloads and its journal. The page is hosted; the data is not —
# the browser fetches straight from this process, so payload bodies never pass
# through anyone else's server. Off registers no route at all, as with metrics.
UI_ENABLED=1

# Token the viewer must present. Unset means one is minted per process and baked
# into the link session_create hands over — never "no token", because this
# surface serves the participant's real payloads and on stdio it rides the
# receiver's listener, which binds 0.0.0.0 so a third party can reach it.
# **Required when NODE_ENV=production**: there, replicas would each mint a
# different one and a link would work only against whichever answered.
# UI_TOKEN=change-me

# Where the viewer page is hosted — the origin of the link.
UI_BASE_URL=https://workbench.ondc.tech

# How the *browser* reaches this engine. Defaults to RECEIVER_PUBLIC_URL, which
# is already the address this process is known to be reachable on. Set it only
# when the viewer and the participant should reach us by different routes.
# UI_ENGINE_URL=https://your-tunnel.example.com

# Origins allowed to call /ui/api. Defaults to the origin of UI_BASE_URL.
# UI_ALLOWED_ORIGINS=https://workbench.ondc.tech

# --- Issue reporting (the incident corpus) ---
# Capture is on by default, and "on" with nothing else configured is modest:
# incidents are captured, redacted and written to a local spool directory, and
# **nothing leaves the machine** until FEEDBACK_ENDPOINT_URL names somewhere for
# them to go. Boot logs which way this went, and where.
# FEEDBACK_DISABLED=1
# FEEDBACK_ENDPOINT_URL=https://ingest.example.com/reports
# FEEDBACK_API_KEY=
# Where reports are written before, and regardless of, any upload. Defaults to
# ~/.ondc-mcp/feedback. This is the trust surface: it is how you answer "what
# did this send about my participant?" by reading a file.
# FEEDBACK_SPOOL_DIR=
FEEDBACK_TIMEOUT_MS=5000
FEEDBACK_SPOOL_MAX_FILES=500
# HMAC salt for identifier pseudonyms. Set it to make pseudonyms stable across
# machines, which is only ever what you want when several deployments are meant
# to look like one installation in the corpus.
# FEEDBACK_SALT=

# Carry session_id and transaction_id **in the clear** on telemetry, so a
# dashboard can deep-link a report or a mirror record back to the run that
# produced it. Off by default.
#
# It adds exactly one key (`correlation`) and changes nothing else: payload
# values are still type tokens, the participant is still pseudonymised, and ids
# quoted inside prose are still scrubbed. The flag is never passed to the
# redaction module at all. Only turn it on for telemetry about your own
# installation.
TELEMETRY_CORRELATION=0

# --- Live mirror (telemetry to a sibling service) ---
# Where mirror records are POSTed. **Unset means mirroring is off**, and that is
# the only switch — a second MIRROR_ENABLED flag would let you turn it "on" with
# nowhere to send, which reads as configured and does nothing.
#
# The mirror is invisible to the model: no tool, no resource. It carries session
# creation, run starts and journal lines, structurally redacted, so a sibling
# service can show a live view of what this mock is doing.
# MIRROR_ENDPOINT_URL=https://mirror.example.com/ingest
# MIRROR_API_KEY=
# Ceiling on one batch POST. It shares the process-wide agent with protocol
# calls, so a hung mirror request holds a connection slot they are also using.
MIRROR_TIMEOUT_MS=5000
# How often a partial batch is flushed. The timer is unref'd, so it never keeps
# a stdio process alive after the client disconnects.
MIRROR_FLUSH_INTERVAL_MS=2000
# Queue length that triggers an immediate (still off-thread) flush.
MIRROR_BATCH_SIZE=100
# Queue ceiling. Full drops the **oldest** record, and the count rides the next
# batch as `dropped_since_last_batch` — a gap that says so beats a silent one.
MIRROR_QUEUE_MAX=1000

# --- Shared state store ---
# Where sessions, transactions, payloads and business data live.
#
# Leave it unset and everything stays in-process: zero infrastructure, but a
# restart wipes it — including the `tsx watch` reload that fires every time you
# save a file mid-flow. Set it and the same state survives both.
#
#   docker compose -f docker-compose.dev.yml up -d
#   REDIS_URL=redis://127.0.0.1:6379
#
# The flow catalog is deliberately never stored here — it is large, derived, and
# re-fetched on demand. See the comments in src/container.ts.
# REDIS_URL=redis://127.0.0.1:6379

# Prepended to every key with `::`, so several projects can share one local
# Redis without collision. Set it empty to write the workbench's literal key
# layout into a Redis it also uses.
REDIS_KEY_PREFIX=ondc-mcp

# Hard ceiling on a single Redis command. Kept below /ready's own 2s probe
# timeout, and it bounds the ACK window — the receiver reads state before it
# answers, so a dead store must not hold the participant's connection open.
REDIS_COMMAND_TIMEOUT_MS=1500

# --- This mock's own wire presence ---
# The participant under test calls us back on these. Under the HTTP transport
# the receiver is mounted on PORT; on stdio it binds RECEIVER_PORT of its own.
RECEIVER_PORT=3001
# What we advertise as bap_uri / bpp_uri. Set this to a tunnel address
# (ngrok, cloudflared) whenever the participant is not on this machine —
# otherwise its callbacks are sent somewhere it cannot reach.
# RECEIVER_PUBLIC_URL=https://your-tunnel.example.com
# Path the receiver and form routes mount under. Defaults to the pathname of
# RECEIVER_PUBLIC_URL, so a deployment behind https://host/api-service works
# unchanged. Set it empty when a proxy strips the prefix before we see it.
# RECEIVER_ROUTE_PREFIX=
# Registry-style id we present as bap_id / bpp_id.
MOCK_SUBSCRIBER_ID=mock.ondc-mcp.local

# --- Flow loop ---
# Budget for one outbound protocol call to the participant.
SEND_TIMEOUT_MS=15000
# Ceiling on one blocking flow_await (5 min) — how long the mock will sit
# waiting for the participant to call back before answering `timed_out` and
# letting the model wait again. Not bounded by REQUEST_TIMEOUT_MS (that bounds
# receiving a request, not running its handler); the ceiling that matters is
# your MCP client's own tool-call timeout, which flow_await holds off with
# progress notifications while it waits.
AWAIT_MAX_WAIT_MS=300000
# Per-step WORKING/AVAILABLE marker lifetime (5h, as the workbench).
FLOW_STATUS_TTL_MS=18000000
# How long an idle mock-runner instance (and its worker threads) is kept.
RUNNER_CACHE_TTL_MS=300000
# Base URLs a sandboxed generate() may fetch. Empty = fetch is never injected.
# RUNNER_FETCH_ALLOWLIST=https://finvu.example.com
# Budget for fetching a counterparty-hosted form.
FORM_FETCH_TIMEOUT_MS=10000
# Transaction records and stored payloads (48h).
TRANSACTION_TTL_MS=172800000
# How long an armed expectation stands (5 min, as the workbench).
EXPECTATION_TTL_MS=300000
