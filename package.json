{
  "name": "ondc-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Production MCP server boilerplate — stdio + Streamable HTTP, MCP spec 2026-07-28",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ondc-mcp": "./dist/entrypoints/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch src/entrypoints/http.ts",
    "dev:stdio": "tsx src/entrypoints/stdio.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/entrypoints/http.js",
    "start:stdio": "node dist/entrypoints/stdio.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/entrypoints/stdio.ts",
    "sdk:check": "npm outdated @modelcontextprotocol/server @modelcontextprotocol/node @modelcontextprotocol/fastify @modelcontextprotocol/client || true",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@modelcontextprotocol/fastify": "2.0.0-beta.5",
    "@modelcontextprotocol/node": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "@ondc/automation-mock-runner": "^1.3.56",
    "close-with-grace": "2.5.0",
    "ejs": "^3.1.10",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "hono": "4.12.32",
    "jose": "6.2.4",
    "jsonpath": "^1.3.0",
    "pino": "10.3.1",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@types/ejs": "^3.1.5",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
